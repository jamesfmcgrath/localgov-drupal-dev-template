{
  "permissions": {
    "allow": [
      "Read(<absolute-path-to-repo>/**)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(ddev drush:*)",
      "Bash(ddev composer:*)",
      "Bash(ddev exec vendor/bin/phpcs {{MODULE_PATH}})",
      "Bash(ddev exec vendor/bin/phpcbf {{MODULE_PATH}})",
      "Bash(ddev exec vendor/bin/phpstan analyse {{MODULE_PATH}})",
      "Bash(ddev exec vendor/bin/phpunit -c web/core {{MODULE_PATH}})"
    ]
  }
}
