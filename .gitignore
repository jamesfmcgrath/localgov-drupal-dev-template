# AI agent tools, tracked files are canonical dev-environment config
# Skills are installed from agr.toml + agr.lock (agr sync / setup.sh); do not vendor copies.
.claude/skills/
.cursor/skills/
.claude/settings.local.json
# Tracked (do NOT ignore): AGENTS.md, CLAUDE.md (import stub), .claude/MEMORY.md,
# .claude/agents/, .claude/commands/, .claude/settings.local.json.dist, agr.toml
# agr.lock is NOT tracked here (agr.toml still holds the {{SKILL_FORK}} token);
# setup.sh generates it on first run and the created project should commit it.

# Drupal / DDEV build artifacts (adjust to your project's policy)
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/sites/*/files/
/web/sites/*/settings.local.php
.ddev/.dbimageBuild/

# OS / editor
.DS_Store

# Node / Prettier / PHPUnit artifacts
/node_modules/
.phpunit.cache/
/web/sites/simpletest/
.superpowers/
