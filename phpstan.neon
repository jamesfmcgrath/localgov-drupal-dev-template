includes:
  - vendor/mglaman/phpstan-drupal/extension.neon
  - vendor/mglaman/phpstan-drupal/rules.neon
  - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
  # Start conservative; raise the level as the custom code hardens.
  level: 2
  # The custom code workspace. Keep in step with LINT_PATHS in the Makefile.
  paths:
    - web/modules/custom
    - web/themes/custom
  drupal:
    drupalRoot: web
